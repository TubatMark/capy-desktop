# Optional. Copy to .env — the app and CLI both read it.
# CAPY_BROWSER=chrome          # use your browser's YouTube cookies (fixes 429 / bot checks)
# CAPY_MODEL=claude-sonnet-5   # picker model (claude-haiku-4-5 cheaper, claude-opus-5-5 best)
# YT_PROXY=http://user:pass@host:port
# CAPY_OUTPUT=./output
# WHISPER_MODEL=/path/to/ggml-large-v3-turbo.bin   # whisper.cpp fallback

# Optional. Copy to .env — the app and CLI both read it at start.
#
# Precedence, lowest to highest: built-in default → these variables → the app's Settings page
# (<CAPY_DATA_DIR>/settings.json, default ~/Library/Application Support/capy/settings.json)
# → per-video settings. So anything saved in Settings wins over this file.
#
# CAPY_BROWSER=chrome          # use your browser's YouTube cookies (fixes 429 / bot checks)
# CAPY_MODEL=claude-sonnet-5   # picker model (claude-haiku-4-5-20251001 cheaper, claude-opus-5-5 best)
# CAPY_OUTPUT=./output         # where jobs and clips go (the desktop app defaults to ~/Movies/capy)
# CAPY_USE_API_KEY=1           # bill ANTHROPIC_API_KEY instead of your Claude login (Settings → Billing does the same)
# ANTHROPIC_API_KEY=sk-ant-…   # only used with CAPY_USE_API_KEY=1 or Settings → API key
# CAPY_DATA_DIR=~/some/folder  # where settings.json lives (the desktop app sets this itself)
# CAPY_FFMPEG_DIR=/path/to/bin # an ffmpeg build with libass, if not Homebrew's ffmpeg-full
# YT_PROXY=http://user:pass@host:port
# WHISPER_MODEL=/path/to/ggml-large-v3-turbo.bin   # whisper.cpp fallback

{
  "name": "capy-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "YouTube URL -> captioned 9:16 shorts, clips picked by Claude",
  "bin": {
    "capy": "./src/cli.ts"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs dev",
    "build": "node scripts/with-sqlite.mjs next build",
    "start": "node scripts/dev.mjs start",
    "clip": "tsx src/cli.ts",
    "check": "tsx src/cli.ts check",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/with-sqlite.mjs vitest run",
    "desktop:bundle": "node scripts/desktop-bundle.mjs",
    "desktop:dev": "pnpm desktop:bundle && electron .",
    "desktop:build": "node scripts/with-sqlite.mjs node scripts/desktop-build.mjs",
    "desktop:pack": "node scripts/with-sqlite.mjs node scripts/desktop-build.mjs --dir",
    "worker": "node scripts/worker.mjs",
    "worker:service": "node scripts/worker-service.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.291",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "archiver": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.18.3",
  "main": "dist-electron/main.cjs",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
